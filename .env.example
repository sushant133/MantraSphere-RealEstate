# Copy to .env.local and fill in. Never commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser — never put secrets there.

# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # production: https://mantrasphere.com.np (non-www)
INTERNAL_URL=                                        # production: http://127.0.0.1:3000 (middleware → app, skips Cloudflare)
IP_HASH_SALT=                                        # openssl rand -hex 16

# ── Database (MongoDB 7, single-node replica set) ───────────────────────
# Docker (auth on):  mongodb://msr_app:<MONGO_APP_PASSWORD>@127.0.0.1:27017/mantrasphere?replicaSet=rs0&authSource=mantrasphere
# npm run db:dev:    mongodb://127.0.0.1:27017/mantrasphere?replicaSet=rs0
MONGODB_URI=
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=                                 # docker-compose only
MONGO_APP_USER=msr_app
MONGO_APP_PASSWORD=                                  # docker-compose only

# ── Seed ────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=info@mantrasphere.com.np
SEED_ADMIN_PHONE=+9779849361011

# ── Storage (Phase 3) ───────────────────────────────────────────────────
STORAGE_DRIVER=local                                 # local | s3
STORAGE_PUBLIC_HOST=                                 # e.g. media.mantrasphere.com.np (for next/image)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Auth.js (Phase 3) ───────────────────────────────────────────────────
AUTH_SECRET=                                         # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SMS_PROVIDER=sparrow                                 # sparrow | aakash | outbox (dev/e2e only: writes to ./.outbox)
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=
AAKASH_SMS_TOKEN=

# ── Email (Phase 3) ─────────────────────────────────────────────────────
EMAIL_PROVIDER=                                       # resend | smtp | outbox (dev/e2e only)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="MantraSphere Real Estate <info@mantrasphere.com.np>"

# ── Spam protection ─────────────────────────────────────────────────────
# Dev/test: Cloudflare's always-pass keys 1x00000000000000000000AA / 1x0000000000000000000000000000000AA.
# Production: real keys are REQUIRED — forms fail closed without them.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=                              # optional; in-memory LRU when empty
UPSTASH_REDIS_REST_TOKEN=

# ── Payments (Phase 5) ──────────────────────────────────────────────────
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
ESEWA_ENV=test                                       # test | live
KHALTI_SECRET_KEY=
KHALTI_ENV=test                                      # test | live

# ── Cron ────────────────────────────────────────────────────────────────
CRON_SECRET=                                         # openssl rand -hex 32 (min 16 chars)
PAYMENT_MODE=                                        # "mock" = simulated gateway for dev/e2e only; never in production

# ── Analytics (with cookie consent) ─────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
